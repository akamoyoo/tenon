#!/usr/bin/env python3
"""tenon: check a Tenon source file.

    tenon check FILE.tn        prove every function in FILE.tn; print what could not be proved
    tenon check -a FILE.tn     print every obligation that could not be proved, not only the first of
                               each function (the later ones often follow from the first)
    tenon check -v FILE.tn     also print the raw output of the proof checker for failures
    tenon emit FILE.tn         check, and if every function is proved, print the C for the file

Each function is proved in its own Lean process, in parallel. A proof is remembered (in
.lake/tenon-cache) under a hash of the language and of the function with everything it is checked
against; an unchanged function is not proved again.

A .tn file contains functions and comments (`// ...` to the end of a line) and nothing else:

    fn name(params) -> int(lo, hi)
      requires (condition)
      uses [callee, ...]            (optional)
    {
      statements
    }

The check is done by Lean: this command writes a Lean file that contains the functions and one theorem
per function, runs Lean on it, and translates what comes back. Nothing here is trusted: a function is
accepted only if Lean accepted its theorem.
"""
import os, re, subprocess, sys

ROOT = os.path.dirname(os.path.abspath(__file__))
I64MAX, I64MIN = '9223372036854775807', '-9223372036854775808'


def functions(src):
    """[(name, [callees], line)] in order of appearance."""
    out = []
    for m in re.finditer(r'^fn\s+([A-Za-z_][A-Za-z_0-9]*)\s*\(', src, re.M):
        head = src[m.start():src.index('{', m.start())] if '{' in src[m.start():] else ''
        u = re.search(r'\buses\s*\[([^\]]*)\]', head)
        callees = [c.strip() for c in u.group(1).split(',') if c.strip()] if u else []
        out.append((m.group(1), callees, src.count('\n', 0, m.start()) + 1))
    return out


HEADER = 'import Surface import Emit\n'          # one line: a line of the source is line + 1 of the generated file


def generate(src, fns):
    body = re.sub(r'^fn(\s)', r'kfn\1', src, flags=re.M)     # same length of lines: positions map by line
    body = body.replace('//', '--')                          # comments: `// ...` to the end of the line
    lean = HEADER + body
    if not lean.endswith('\n'):
        lean += '\n'
    params = {}
    for m in re.finditer(r'^fn\s+([A-Za-z_][A-Za-z_0-9]*)\s*\((.*?)\)\s*->', src, re.M | re.S):
        params[m.group(1)] = re.findall(r'([A-Za-z_][A-Za-z_0-9]*)\s*:', m.group(2))
    thms = {}
    for name, callees, _ in fns:
        cs = ', '.join(callees)
        thms[name] = (f'\nopen Tenon in\ntheorem {name}_ok : FnOk [{cs}] {name} := by\n'
                      f'  have _args : Tag "@0|{",".join(params[name])}" := Tag.intro _\n  kvc {name} [{cs}]\n'
                      f'#print axioms {name}_ok\n')
    order = ', '.join(n for n, _, _ in reversed(fns))        # a program lists its functions newest first
    starts = [m.start() for m in re.finditer(r'^fn\s', src, re.M)] + [len(src)]
    local = {}
    for k, (n, _, _) in enumerate(fns):                      # names of locals and counters, in source order
        text = src[starts[k]:starts[k + 1]]
        local[n] = [a or b for a, b in re.findall(r'\blet\s+([A-Za-z_]\w*)\s*:|(?<!parallel )\bfor\s+([A-Za-z_]\w*)\s+upto', text)]
    def q(xs):
        return ', '.join('"%s"' % x for x in xs)
    names = ', '.join('{ name := "%s", params := [%s], locals := [%s] }' % (n, q(params[n]), q(local[n]))
                      for n, _, _ in reversed(fns))
    emit = ('\nopen Tenon Tenon.Emit in\n#eval match emitProgram {} [' + order + '] [' + names + '] with\n'
            '  | .ok c => IO.println ("//TENON-C-BEGIN\\n" ++ c ++ "\\n//TENON-C-END")\n'
            '  | .error e => IO.println ("TENON-EMIT-ERROR " ++ e)\n')
    return lean, thms, emit


def messages(out):
    """Split Lean's output into (line, col, kind, text)."""
    msgs, cur = [], None
    for line in out.splitlines():
        m = re.match(r'^[^:\s]+\.lean:(\d+):(\d+): (error|warning|info)(?:\([^)]*\))?: ?(.*)$', line)
        if m:
            cur = [int(m.group(1)), int(m.group(2)), m.group(3), m.group(4)]
            msgs.append(cur)
        elif cur is not None:
            cur[3] += '\n' + line
    return msgs


def goals(text):
    """The goals of an 'unsolved goals' message: [(hypotheses, goal)]."""
    res, hyps, goal = [], [], None
    for line in text.splitlines()[1:]:
        if line.startswith('case '):
            if goal is not None:
                res.append((hyps, goal))
            hyps, goal = [], None
        elif line.startswith('⊢'):
            goal = line[1:].strip()
        elif goal is not None and line.startswith(' '):
            goal += ' ' + line.strip()
        elif goal is None:
            if line.startswith(' ') and hyps:
                hyps[-1] += ' ' + line.strip()
            else:
                hyps.append(line)
        else:                                                # a new goal without a `case` line
            res.append((hyps, goal))
            hyps, goal = [line], None
    if goal is not None:
        res.append((hyps, goal))
    return res


SUP = str.maketrans('⁰¹²³⁴⁵⁶⁷⁸⁹', '0123456789')


def rename(hyps, goal, names):
    """Give the values of the variables in scope their source names. Lean lists the hypotheses in the
    order they were introduced; the values of the innermost environment are the last variables named
    x (integers, floats) or l (arrays) that were introduced, in the order of the scope. If their number
    does not match the scope, nothing is renamed."""
    decl = []
    for h in hyps:
        m = re.match(r'^((?:[xl]✝[⁰¹²³⁴⁵⁶⁷⁸⁹]*\s*)+):\s*(Int|Float|List Int|List Float)\s*$', h)
        if m:
            decl += m.group(1).split()
    if not names or len(decl) < len(names):
        return goal, False
    mapping = dict(zip(decl[-len(names):], names))
    def sub(m):
        return mapping.get(m.group(0), m.group(0))
    g = re.sub(r'[xl]✝[⁰¹²³⁴⁵⁶⁷⁸⁹]*', sub, goal)
    g = re.sub(r'↑?([A-Za-z_][A-Za-z_0-9]*)\.length', r'len(\1)', g)
    g = g.replace('↑', '')
    return g, True


def unparen_elems(g):
    """`x[(t).toNat]?.getD 0` and `x[t.toNat]?.getD 0` become `x[t]`; `(some (e)).getD 0` becomes `e`."""
    out, k = [], 0
    while k < len(g):
        m = re.match(r'([A-Za-z_][A-Za-z_0-9✝⁰¹²³⁴⁵⁶⁷⁸⁹]*)\[', g[k:])
        if m and (k == 0 or not (g[k - 1].isalnum() or g[k - 1] == '_')):
            start = k + m.end()
            depth, e = 1, start
            while e < len(g) and depth:
                depth += {'[': 1, ']': -1}.get(g[e], 0)
                e += 1
            inner = g[start:e - 1]
            rest = g[e:]
            if rest.startswith('?.getD 0'):
                inner = re.sub(r'\.toNat$', '', inner)
                if inner.startswith('(') and inner.endswith(')'):
                    inner = inner[1:-1]
                out.append(f'{m.group(1)}[{unparen_elems(inner)}]')
                k = e + len('?.getD 0')
                continue
        out.append(g[k]); k += 1
    g = ''.join(out)
    g = re.sub(r'\(some \((.*?)\)\)\.getD 0', r'\1', g)
    g = re.sub(r'\(some ([^()]*?)\)\.getD 0', r'\1', g)
    return g


def unsum(g):
    """`sumA x a b` becomes `sum(x, a, b)`; `max a b` becomes `max(a, b)`."""
    def args(t, k, n):
        out = []
        while len(out) < n and k < len(t):
            while k < len(t) and t[k] == ' ':
                k += 1
            if k < len(t) and t[k] == '(':
                depth, e = 1, k + 1
                while e < len(t) and depth:
                    depth += {'(': 1, ')': -1}.get(t[e], 0)
                    e += 1
                out.append(t[k + 1:e - 1]); k = e
            else:
                m = re.match(r'[^\s()]+', t[k:])
                if not m:
                    break
                out.append(m.group(0)); k += m.end()
        return out, k
    for fn, n in (('sumA', 3), ('max', 2), ('min', 2)):
        while True:
            m = re.search(r'(?<![A-Za-z_.])' + fn + r' ', g)
            if not m:
                break
            a, end = args(g, m.end(), n)
            if len(a) != n:
                break
            name = 'sum' if fn == 'sumA' else fn
            g = g[:m.start()] + f'{name}(' + ', '.join(unsum(x) for x in a) + ')' + g[end:]
    return g


def pretty(goal):
    goal = unparen_elems(goal)
    goal = unsum(goal)
    goal = re.sub(r'([A-Za-z_])✝[⁰¹²³⁴⁵⁶⁷⁸⁹]*', r'\1', goal)
    g = goal.replace(I64MIN, 'INT64_MIN').replace(I64MAX, 'INT64_MAX')
    g = re.sub(r'i✝[⁰¹²³⁴⁵⁶⁷⁸⁹]*', '<iteration>', g)
    g = re.sub(r'v✝[⁰¹²³⁴⁵⁶⁷⁸⁹]*', '<element>', g)
    return g.replace('∧', '&&').replace('≤', '<=').replace('≥', '>=').replace('¬', 'not ')


def kind(goal):
    if re.search(r'≤ ' + I64MAX + r'$', goal) or goal.startswith(I64MIN + ' ≤'):
        return 'cannot show that this value stays within 64 bits'
    return 'cannot show'


SRC = ['']


def describe(name, hyps, goal, src_lines, src_line_of_pos):
    """One obligation that could not be proved, in the words of the source."""
    tag = None
    for h in hyps:
        m = re.search(r'Tag "@(\d+)\|([^"|]*)(\|(?:inv|ensures))?"', h)
        if m:
            tag = m
    if not tag:
        return f'{SRC[0]}: in `{name}`: {kind(goal)}\n    needed: {pretty(goal)}   (values shown with internal names)'
    sl = src_line_of_pos(int(tag.group(1)))
    names = [n for n in tag.group(2).split(',') if n]
    g = goal if '✝' not in re.sub(r'[iv]✝', '', goal) else rename(hyps, goal, names)[0]
    g = re.sub(r'↑?([A-Za-z_][A-Za-z_0-9]*)\.length', r'len(\1)', g).replace('↑', '')
    code = src_lines[sl - 1].strip() if 0 < sl <= len(src_lines) else ''
    counter = 'iter_'
    for back in range(sl - 1, -1, -1):                       # the nearest loop above this line
        lm = re.match(r'\s*(?:for\s+([A-Za-z_][A-Za-z_0-9]*)\s+upto|loop\b)', src_lines[back])
        if lm:
            counter = lm.group(1) or 'iter_'
            break
    g = re.sub(r'i✝[⁰¹²³⁴⁵⁶⁷⁸⁹]*', counter, g)
    what = kind(goal)
    if tag.group(3) == '|inv':
        what = 'cannot show that the invariant of this loop holds again after an iteration'
    elif tag.group(3) == '|ensures':
        what = 'cannot show the postcondition'
    elif code.startswith('loop') and what == 'cannot show':
        what = ('cannot show that this loop leaves by `break` within its bound '
                '(or that its invariant holds on entry)')
    elif code.startswith('for') and what == 'cannot show':
        what = 'cannot show that the invariant of this loop holds on entry'
    return f'{SRC[0]}:{sl}: in `{name}`: {what}\n    {code}\n    needed: {pretty(g)}'


def main():
    args = [a for a in sys.argv[1:] if a not in ('-v', '-a')]
    verbose = '-v' in sys.argv
    show_all = '-a' in sys.argv
    if len(args) != 2 or args[0] not in ('check', 'emit'):
        sys.exit(__doc__)
    path = args[1]
    SRC[0] = path
    src = open(path).read()
    src_lines = src.splitlines()
    fns = functions(src)
    if not fns:
        sys.exit(f'{path}: no function found (a function starts with `fn name(` at the start of a line)')
    base, thms, emit_cmd = generate(src, fns)
    work = os.path.join(ROOT, '.lake', 'tenon-check')
    cache = os.path.join(ROOT, '.lake', 'tenon-cache')
    os.makedirs(work, exist_ok=True)
    os.makedirs(cache, exist_ok=True)
    env = dict(os.environ, PATH=os.path.expanduser('~/.elan/bin') + os.pathsep + os.environ.get('PATH', ''))
    b = subprocess.run(['lake', 'build', 'Surface', 'Emit'], cwd=ROOT, env=env, capture_output=True, text=True)
    if b.returncode != 0:
        sys.exit('tenon: the language itself failed to build:\n' + b.stdout[-2000:] + b.stderr[-2000:])
    import hashlib, concurrent.futures
    lang = hashlib.sha256()
    for f in ('Tenon.lean', 'Surface.lean', 'Emit.lean'):
        lang.update(open(os.path.join(ROOT, f), 'rb').read())
    jobs = {}
    for name, _, _ in fns:
        text = base + thms[name]
        key = hashlib.sha256(lang.digest() + text.encode()).hexdigest()
        jobs[name] = (text, key)

    def prove(name):
        text, key = jobs[name]
        if os.path.exists(os.path.join(cache, key)):
            return name, '', True
        gen = os.path.join(work, f'Check_{name}.lean')
        open(gen, 'w').write(text)
        r = subprocess.run(['lake', 'env', 'lean', gen], cwd=ROOT, env=env, capture_output=True, text=True)
        out = r.stdout + r.stderr
        ok = r.returncode == 0 and not any(m[2] == 'error' for m in messages(out))
        # belt and braces: a theorem that depends on `sorryAx` is not proved, whatever else was printed
        if f"'{name}_ok' depends on axioms" not in out or 'sorryAx' in out:
            ok = False
        if ok:
            open(os.path.join(cache, key), 'w').write('')
        return name, out, ok

    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, min(len(fns), os.cpu_count() or 1))) as ex:
        results = list(ex.map(prove, [n for n, _, _ in fns]))
    lean_bytes = base.encode()
    thm_start = base.count('\n') + 2
    failed, shown = set(), 0
    printed = set()

    def say(text):
        nonlocal shown
        if text not in printed:
            printed.add(text)
            print(text)
            shown += 1

    def src_line_of_pos(pos):
        return lean_bytes[:pos].count(b'\n')                 # generated line - 1 = source line

    for name, out, ok in results:
        if ok:
            continue
        failed.add(name)
        msgs = [m for m in messages(out) if m[2] == 'error']
        if not msgs:
            say(f'{path}: in `{name}`: the proof checker failed:\n' + out[-1500:])
        for line, col, _, text in msgs:
            if line < thm_start:                                 # an error in the functions themselves
                sl = line - 1
                first = text.splitlines()[0]
                code = src_lines[sl - 1].strip() if 0 < sl <= len(src_lines) else ''
                say(f'{path}:{sl}:{col + 1}: error: {first}\n    {code}')
                continue
            if not text.startswith('unsolved goals'):
                say(f'{path}: in `{name}`: {text.splitlines()[0]}')
                continue
            gs = goals(text)
            for gi, (hyps, goal) in enumerate(gs):
                if gi > 0 and not show_all:
                    say(f'    ({len(gs) - 1} more obligation(s) of `{name}` not shown; they often follow from the first. '
                        f'`tenon check -a` shows all.)')
                    break
                say(describe(name, hyps, goal, src_lines, src_line_of_pos))
            if verbose:
                print(text)
    ok = [n for n, _, _ in fns if n not in failed]
    log = sys.stderr if args[0] == 'emit' else sys.stdout
    for n in ok:
        print(f'{path}: `{n}`: proved', file=log)
    if failed:
        print(f'{len(failed)} of {len(fns)} function(s) not proved' + ('; no C written' if args[0] == 'emit' else ''),
              file=log)
        sys.exit(1)
    print(f'{len(fns)} function(s) proved', file=log)
    if args[0] == 'emit':
        gen = os.path.join(work, 'Emit.lean')
        open(gen, 'w').write(base + emit_cmd)
        out = subprocess.run(['lake', 'env', 'lean', gen], cwd=ROOT, env=env, capture_output=True, text=True).stdout
        if 'TENON-EMIT-ERROR' in out:
            sys.exit('tenon: ' + out[out.index('TENON-EMIT-ERROR') + 17:].splitlines()[0])
        if '//TENON-C-BEGIN' not in out:
            sys.exit('tenon: the generator produced no output')
        print(out[out.index('//TENON-C-BEGIN') + 16:out.index('//TENON-C-END')].rstrip())


if __name__ == '__main__':
    main()
